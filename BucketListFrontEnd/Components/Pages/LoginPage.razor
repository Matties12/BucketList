@page "/login"
@inject HttpClient Http
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="lp-wrap">

   
    <div class="lp-left">
        <div class="lp-logo">Bucketlist</div>
        <div class="lp-tagline">
            <h2>Jouw dromen,<br />jouw lijst.</h2>
            <p>Log in om je bucketlist te beheren<br />en bij te houden.</p>
        </div>
        <div class="lp-dots">
            <div class="lp-dot active"></div>
            <div class="lp-dot"></div>
            <div class="lp-dot"></div>
        </div>
    </div>

   
    <div class="lp-right">

        <div class="lp-tabs">
            <button class="lp-tab @(activeTab == "login" ? "active" : "")"
                    @onclick='() => activeTab = "login"'>
                Inloggen
            </button>
            <button class="lp-tab @(activeTab == "register" ? "active" : "")"
                    @onclick='() => activeTab = "register"'>
                Registreren
            </button>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
                <div class="lp-err">@errorMessage</div>
        }
        @if (!string.IsNullOrEmpty(successMessage))
        {
                <div class="lp-ok">@successMessage</div>
        }

        @if (activeTab == "login")
        {
                <label class="lp-label">Gebruikersnaam</label>
                <input class="lp-input" type="text" placeholder="Jouw gebruikersnaam" @bind="userName" />
                <label class="lp-label">Wachtwoord</label>
                <input class="lp-input" type="password" placeholder="••••••••" @bind="pass" />
                <button class="lp-btn" @onclick="LoginUser" disabled="@isLoading">
                @(isLoading ? "Bezig..." : "Inloggen")
                </button>
        }

        @if (activeTab == "register")
        {
                <label class="lp-label">Gebruikersnaam</label>
                <input class="lp-input" type="text" placeholder="Kies een gebruikersnaam" @bind="regUserName" />
                <label class="lp-label">Wachtwoord</label>
                <input class="lp-input" type="password" placeholder="••••••••" @bind="regPass" />
                <label class="lp-label">Bevestig wachtwoord</label>
                <input class="lp-input" type="password" placeholder="••••••••" @bind="regPassConfirm" />
                <button class="lp-btn" @onclick="RegisterUser" disabled="@isLoading">
                @(isLoading ? "Bezig..." : "Registreren")
                </button>
        }

    </div>
</div>

<style>
    .lp-wrap {
        display: flex;
        min-height: 520px;
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid #e5e7eb;
        font-family: 'DM Sans', sans-serif;
        max-width: 780px;
        margin: 60px auto;
        box-shadow: 0 8px 40px rgba(0,0,0,0.08);
    }

    .lp-left {
        width: 42%;
        background: #1a1a2e;
        padding: 48px 36px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        overflow: hidden;
    }

        .lp-left::before {
            content: '';
            position: absolute;
            top: -80px;
            right: -80px;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: rgba(102,126,234,0.18);
        }

        .lp-left::after {
            content: '';
            position: absolute;
            bottom: -60px;
            left: -40px;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: rgba(118,75,162,0.15);
        }

    .lp-logo {
        font-family: 'Georgia', serif;
        color: #fff;
        font-size: 26px;
        font-style: italic;
        position: relative;
        z-index: 1;
    }

    .lp-tagline {
        position: relative;
        z-index: 1;
    }

        .lp-tagline h2 {
            font-family: 'Georgia', serif;
            color: #fff;
            font-size: 24px;
            font-weight: 400;
            margin: 0 0 10px;
            line-height: 1.3;
        }

        .lp-tagline p {
            color: rgba(255,255,255,0.5);
            font-size: 13px;
            margin: 0;
        }

    .lp-dots {
        display: flex;
        gap: 6px;
        position: relative;
        z-index: 1;
    }

    .lp-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: rgba(255,255,255,0.2);
    }

        .lp-dot.active {
            background: #667eea;
            width: 22px;
            border-radius: 4px;
        }

    .lp-right {
        flex: 1;
        background: #fff;
        padding: 40px 36px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .lp-tabs {
        display: flex;
        margin-bottom: 28px;
        background: #f3f4f6;
        border-radius: 10px;
        padding: 4px;
    }

    .lp-tab {
        flex: 1;
        padding: 9px 0;
        border: none;
        background: transparent;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        border-radius: 7px;
        color: #6b7280;
        transition: all 0.2s;
    }

        .lp-tab.active {
            background: #fff;
            color: #111;
            border: 1px solid #e5e7eb;
        }

    .lp-label {
        font-size: 11px;
        font-weight: 600;
        color: #9ca3af;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        margin-bottom: 6px;
        display: block;
    }

    .lp-input {
        width: 100%;
        padding: 10px 14px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        font-size: 14px;
        color: #111;
        margin-bottom: 14px;
        box-sizing: border-box;
        outline: none;
    }

        .lp-input:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102,126,234,0.12);
        }

    .lp-btn {
        width: 100%;
        padding: 12px;
        background: #1a1a2e;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        margin-top: 4px;
    }

        .lp-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

    .lp-err {
        padding: 10px 14px;
        background: #fff0f0;
        border: 1px solid #fecaca;
        border-radius: 8px;
        color: #c00;
        font-size: 13px;
        margin-bottom: 16px;
    }

    .lp-ok {
        padding: 10px 14px;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 8px;
        color: #166534;
        font-size: 13px;
        margin-bottom: 16px;
    }
</style>

@code {
    private string activeTab = "login";

    private string userName = "";
    private string pass = "";

    private string regUserName = "";
    private string regPass = "";
    private string regPassConfirm = "";

    private string errorMessage = "";
    private string successMessage = "";
    private bool isLoading = false;

    private async Task LoginUser()
    {
        errorMessage = "";
        isLoading = true;

        try
        {
            var url = $"/users/login?username={Uri.EscapeDataString(userName)}&password={Uri.EscapeDataString(pass)}";
            var response = await Http.GetAsync(url);

            if (response.IsSuccessStatusCode)
            {
                var user = await response.Content.ReadFromJsonAsync<UserDto>();
                await JS.InvokeVoidAsync("sessionStorage.setItem", "userId", user!.UserId.ToString());
                await JS.InvokeVoidAsync("sessionStorage.setItem", "userName", user.Username);
                Navigation.NavigateTo("/bucketlistitem");
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                errorMessage = "Foute gebruikersnaam of wachtwoord.";
            }
            else
            {
                errorMessage = "Onbekende fout bij het inloggen.";
            }
        }
        catch
        {
            errorMessage = "Kan geen verbinding maken met de server.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RegisterUser()
    {
        errorMessage = "";
        successMessage = "";

        if (string.IsNullOrWhiteSpace(regUserName) || string.IsNullOrWhiteSpace(regPass))
        {
            errorMessage = "Vul alle velden in.";
            return;
        }

        if (regPass != regPassConfirm)
        {
            errorMessage = "Wachtwoorden komen niet overeen.";
            return;
        }

        isLoading = true;

        try
        {
            var url = $"/AddUser?userName={Uri.EscapeDataString(regUserName)}&password={Uri.EscapeDataString(regPass)}";
            var response = await Http.PostAsync(url, null);

            if (response.IsSuccessStatusCode)
            {
                successMessage = "Account aangemaakt! Je kan nu inloggen.";
                regUserName = "";
                regPass = "";
                regPassConfirm = "";
                activeTab = "login";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                errorMessage = "Deze gebruikersnaam is al in gebruik.";
            }
            else
            {
                errorMessage = "Onbekende fout bij het registreren.";
            }
        }
        catch
        {
            errorMessage = "Kan geen verbinding maken met de server.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private class UserDto
    {
        public int UserId { get; set; }
        public string Username { get; set; } = "";
    }
}